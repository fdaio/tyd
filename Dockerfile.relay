# Optional standalone tyd-relay. Default clients use CP /relay.
#   docker compose --profile standalone-relay up -d --build
#
# GOPROXY is passed through to the build so a host with a network-restricted or
# flaky route to proxy.golang.org can point it somewhere else. Unset (the
# default) keeps the toolchain default.

FROM golang:1.26-alpine AS build
WORKDIR /src
# Declared before `go mod download` so it applies to the fetch, not just the
# compile. An empty value leaves the toolchain default.
ARG GOPROXY=
ENV GOPROXY=$GOPROXY
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG GOMAXPROCS=1
ENV GOMAXPROCS=$GOMAXPROCS
RUN CGO_ENABLED=0 GOOS=linux go build -p "$GOMAXPROCS" -trimpath -ldflags "-s -w" \
	-o /out/relay ./cmd/relay

FROM scratch
COPY --from=build /out/relay /relay
EXPOSE 9090
USER 65532:65532
ENTRYPOINT ["/relay"]
CMD ["-listen", "0.0.0.0:9090"]
