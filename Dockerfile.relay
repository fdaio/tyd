# Optional standalone tyd-relay. Default clients use CP /relay.
#   docker compose --profile standalone-relay up -d --build

FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG GOMAXPROCS=1
ENV GOMAXPROCS=$GOMAXPROCS
RUN CGO_ENABLED=0 GOOS=linux go build -p "$GOMAXPROCS" -trimpath -ldflags "-s -w" \
	-o /out/relay ./cmd/relay

FROM scratch
COPY --from=build /out/relay /relay
EXPOSE 9090
USER 65532:65532
ENTRYPOINT ["/relay"]
CMD ["-listen", "0.0.0.0:9090"]
