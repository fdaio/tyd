# Public Control Panel origin (register URLs + install.sh /releases links).
TYD_CP_BASE_URL=https://app.getfda.dev

# Host port published to the CP container.
TYD_CP_PORT=8080

# Host port for tyd-relay (dual-NAT rendezvous). Edge TLS → relay.getfda.dev.
TYD_RELAY_PORT=9090

# Host directory mounted at /releases inside the container (tyd-*.tar.gz).
# TYD_CP_RELEASE_HOST_DIR=./releases
