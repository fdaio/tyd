# Control Panel — pairing HTTP API + WebSocket /relay (no TTY storage).
#
# Default (last) stage COPIES a prebuilt linux binary — no Go toolchain in Docker.
#   make docker-prep && docker compose build
# On a 1C/1G VPS: copy bin/controlpanel from CI, then compose build (seconds).
#
# Compile inside Docker only when needed (slow / high RAM):
#   docker build --target runtime-from-source -f Dockerfile.controlpanel .
#
# Runtime base is scratch (static Go binary) — avoids pulling distroless/golang
# on the common path.

FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG GOMAXPROCS=1
ENV GOMAXPROCS=$GOMAXPROCS
RUN CGO_ENABLED=0 GOOS=linux go build -p "$GOMAXPROCS" -trimpath -ldflags "-s -w" \
	-o /out/controlpanel ./cmd/controlpanel

FROM scratch AS runtime-from-source
COPY --from=build /out/controlpanel /controlpanel
EXPOSE 8080
USER 65532:65532
ENTRYPOINT ["/controlpanel"]
CMD ["-listen", "0.0.0.0:8080"]

# Default target: prebuilt binary from make docker-prep (must be last stage).
FROM scratch AS runtime
COPY bin/controlpanel /controlpanel
EXPOSE 8080
USER 65532:65532
ENTRYPOINT ["/controlpanel"]
CMD ["-listen", "0.0.0.0:8080"]
