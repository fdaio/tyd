# Control Panel — pairing HTTP API + WebSocket /relay (no TTY storage).
#
# Default image: compile inside Docker. Works with classic Compose (no buildx)
# and without a host Go toolchain:
#   docker compose up -d --build
#
# Fast path (separate file — classic builders evaluate every stage, so a
# COPY bin/ stage cannot live in this Dockerfile unless bin/ always exists):
#   make docker
#
# 1C/1G: in-Docker compile needs RAM/swap; or run `make docker` on a fat host
# and copy the tagged image / bin/controlpanel to the VPS.

FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG GOMAXPROCS=1
ENV GOMAXPROCS=$GOMAXPROCS
RUN CGO_ENABLED=0 GOOS=linux go build -p "$GOMAXPROCS" -trimpath -ldflags "-s -w" \
	-o /out/controlpanel ./cmd/controlpanel

FROM scratch
COPY --from=build /out/controlpanel /controlpanel
EXPOSE 8080
USER 65532:65532
ENTRYPOINT ["/controlpanel"]
CMD ["-listen", "0.0.0.0:8080"]
